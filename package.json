{
  "name": "feedtubes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:ext": "bun run scripts/build.ts",
    "lint": "bun run version:check && bun run i18n:check && bun run typecheck && bun run lint:ts && bun run format:check && bun run lint:webext",
    "lint:webext": "bun run build:ext && web-ext lint",
    "lint:ts": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "dev": "bun run scripts/dev.ts",
    "start": "bun run dev",
    "start:librewolf": "bun run scripts/run-librewolf.ts",
    "build": "bun run build:ext && web-ext build",
    "package:source": "git archive --format=zip --output=dist/feedtubes-source.zip HEAD",
    "bump": "bun run scripts/version.ts",
    "bump:patch": "bun run scripts/version.ts patch",
    "bump:minor": "bun run scripts/version.ts minor",
    "bump:major": "bun run scripts/version.ts major",
    "version:check": "bun run scripts/version.ts check",
    "i18n:keys": "bun run scripts/i18n-keys.ts",
    "i18n:check": "bun run scripts/i18n-keys.ts check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/firefox-webext-browser": "^143.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1"
  }
}
