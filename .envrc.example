# Copy this file to .envrc and fill in your values:
#   cp .envrc.example .envrc
# Then allow direnv (required once per clone, and again after every edit):
#   direnv allow
#
# .envrc itself is gitignored. Never commit real credentials.

# --- AMO signing (docs/RELEASE.md) ------------------------------------------
# JWT issuer and secret from https://addons.mozilla.org/developers/addon/api/key/
# `web-ext sign` reads both automatically. Treat them like passwords.
export WEB_EXT_API_KEY="user:12345678:123"
export WEB_EXT_API_SECRET="your-jwt-secret"

# --- Browser binaries (optional) ---------------------------------------------
# `bun run dev` auto-detects Firefox (scripts/browser-binary.ts). Set this to use
# a specific build, e.g. Developer Edition or Nightly.
# export FIREFOX_BIN=/usr/bin/firefox-developer-edition

# `bun run start:librewolf` uses this instead of the default LibreWolf path
# (scripts/run-librewolf.ts).
# export LIBREWOLF_BIN=/usr/bin/librewolf
